{
  "Jwt": {
    "SecretKey": "CasinoAtlanticCity-SecretKey-Development-2026"
  },
  "ReverseProxy": {
    "Routes": {
      "authentication-route": {
        "ClusterId": "authentication-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "fixed"
      },

      "carga-contenido-route": {
        "ClusterId": "carga-masiva-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/cargas/{id}/contenido",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "fixed"
      },

      "control-route": {
        "ClusterId": "control-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/cargas/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "fixed"
      }
    },
    "Clusters": {
      "authentication-cluster": {
        "Destinations": {
          "authentication": {
            "Address": "http://authentication:8080/"
          }
        }
      },
      "control-cluster": {
        "Destinations": {
          "control": {
            "Address": "http://control:8080/"
          }
        }
      },
      "carga-masiva-cluster": {
        "Destinations": {
          "carga-masiva": {
            "Address": "http://carga-masiva:8080/"
          }
        }
      }
    }
  }
}